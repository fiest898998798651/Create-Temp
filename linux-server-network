//NGINX
fileConfig => /etc/nginx/nginx.cof
compile => sudo nginx -t
reload => sudo nginx -s reload

nginx สามารถใช้ port เดียวกันแต่ชื่อต่างกันและ run ในเครื่องได้
server{
	listen 80; 
//port สามารถเหมือนกันได้ในหลาย file config เป็นข้อดีของการทำ revese peoxrt ของ nginx
	servername myapp.local;
//สามารถมีได้หลาย servername ภายใต้ port เดียวกัน
	root /usr/share/myapp.local;
//path ที่ทำการเก็บ project
	index index.html index.htm;
//file แรกที่ทำการถูกเรียกใช้ภายใน root
	charset utf-8;
//??
}
แต่ในการเปลี่ยนทุกอย่างแล้วถ้ารันในเครื่องต้องไปเปลี่ยน config ในเครื่องให้สามารถมองเห็น domain อื่นด้วย

